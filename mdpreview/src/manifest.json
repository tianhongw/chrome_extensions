{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "MD Preview",
  "description": "__MSG_extDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["detect.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png", "vendor/katex/katex.min.css", "vendor/katex/fonts/*"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ]
}
