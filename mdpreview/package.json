{
  "name": "mdpreview",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that renders Markdown files in the browser",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "package": "node scripts/build.mjs --zip"
  },
  "license": "MIT",
  "dependencies": {
    "@mdit/plugin-tasklist": "^1.1.1",
    "@mdit/plugin-tex": "^1.1.1",
    "dompurify": "^3.4.15",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
